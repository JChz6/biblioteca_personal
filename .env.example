# Copia este archivo a .env y completa los valores. .env nunca se commitea.

# Tu email — se siembra como owner en el primer arranque
OWNER_EMAIL=jesuschavez612@gmail.com

# Credenciales OAuth de Google (Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Clave para firmar la cookie de sesión — genera una con: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=

# URL base pública de la app (sin slash final).
# En local: http://localhost:8010 — en producción (Docker + Cloudflare Tunnel): https://biblioteca.tudominio.com
BASE_URL=http://localhost:8010

# Solo para producción: token del túnel de Cloudflare (Zero Trust > Networks > Tunnels > tu túnel > Docker)
CLOUDFLARE_TUNNEL_TOKEN=

# GCP / BigQuery / GCS (ya existentes en el proyecto)
GCP_PROJECT_ID=big-query-406221
BQ_DATASET=biblioteca_personal
BQ_TABLE=catalogo
GCS_BUCKET=biblioteca_personal

# Ruta al service account (Google Cloud SDK lo lee automáticamente de esta variable)
GOOGLE_APPLICATION_CREDENTIALS=./service_account.json

# Datos locales de la app
DATABASE_URL=sqlite:///./data/app.db
PENDING_DIR=./data/pending
